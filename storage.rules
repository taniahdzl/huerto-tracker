rules_version = '2';

// Cloud Storage — evidencia de tareas (ver storage.js/chores.js). Cross-
// service: consulta el rol del usuario en Firestore (usuarios/{uid}.rol)
// vía firestore.get(), mismo campo/valor que usa isAdmin() en
// firestore.rules — no hay forma de compartir la función entre los dos
// archivos de reglas (lenguajes/servicios separados), así que si el campo
// de rol cambia algún día hay que actualizar AMBOS.
//
// Path de Firestore hardcodeado a (default) porque las Storage Rules no
// tienen la variable {database} que sí existe en match /databases/
// {database}/documents de firestore.rules — confirmado contra la
// documentación oficial de cross-service rules, que también exige la ruta
// completamente especificada (con $(...) para interpolar variables).
//
// Tareas autoasignadas (2026-09-06): además del admin (asistencia/
// completarTarea de siempre), el CREADOR de la tarea referenciada también
// puede escribir su propia evidencia al enviarla a revisión
// (enviarARevision en chores.js) — se resuelve leyendo
// tareas/{id}.creadorId, mismo mecanismo cross-service que ya usa
// isAdmin() acá arriba. IMPORTANTE: {tareaId} en el match de abajo captura
// el NOMBRE DE ARCHIVO completo ("<id>.jpg", un solo segmento de path —
// subirEvidenciaTarea sube a `evidencia_tareas/${tareaId}.jpg`), no el id
// solo — de ahí el .split('.')[0] antes de usarlo como id de documento;
// sin él, firestore.get() buscaría un doc "<id>.jpg" que nunca existe y
// esta rama fallaría siempre. Si el id resultante no existe como
// documento de `tareas`, ese firestore.get() lanza y la rama se evalúa a
// false (no tumba la rama de admin).
service firebase.storage {
  match /b/{bucket}/o {
    match /evidencia_tareas/{tareaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        firestore.get(/databases/(default)/documents/tareas/$(tareaId.split('.')[0])).data.creadorId == request.auth.uid
      );
    }
  }
}
