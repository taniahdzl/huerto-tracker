rules_version = '2';

// Cloud Storage — evidencia de tareas (ver storage.js/chores.js). Cross-
// service: consulta el rol del usuario en Firestore (usuarios/{uid}.rol)
// vía firestore.get(), mismo campo/valor que usa isAdmin() en
// firestore.rules — no hay forma de compartir la función entre los dos
// archivos de reglas (lenguajes/servicios separados), así que si el campo
// de rol cambia algún día hay que actualizar AMBOS.
//
// Path de Firestore hardcodeado a (default) porque las Storage Rules no
// tienen la variable {database} que sí existe en match /databases/
// {database}/documents de firestore.rules — confirmado contra la
// documentación oficial de cross-service rules, que también exige la ruta
// completamente especificada (con $(...) para interpolar variables).
service firebase.storage {
  match /b/{bucket}/o {
    match /evidencia_tareas/{tareaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
  }
}
