rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Deny-by-default: cualquier colección no listada explícitamente
    // abajo queda bloqueada, tanto en lectura como en escritura.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Catálogos y Camas: todos leen/crean/actualizan, solo admin elimina ──
    match /catalogo_semillas/{plantaId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();
    }

    match /catalogo_quimicos/{quimicoId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();
    }

    match /camas_cosecha/{camaId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();
    }

    // registro_actividad: sin cambios, fuera de la matriz RBAC de esta
    // fase — sigue siendo log de auditoría append-only (ver _logActividad
    // en db.js/chores.js/usuarios.js).
    match /registro_actividad/{logId} {
      allow read:          if request.auth != null;
      allow create:        if request.auth != null;
      allow update, delete: if false;
    }

    // ── Inventario, Tareas, Asistencias: todos leen, solo admin escribe ──
    // Tareas autoasignadas con aprobación de admin (2026-09-06): un
    // documento sin `origen` es uno creado ANTES de este cambio — se lee
    // como 'asignada' vía .get('origen','asignada'), mismo default que
    // _datosNuevaTarea (chores.js), para no romper tareas ya existentes.
    match /tareas/{tareaId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          // Cualquier autenticado puede autoasignarse una tarea (incluso
          // grupal — sin restricción de a quién más incluye en
          // `asignados`), siempre que se declare como propia creadora y
          // nazca en 'pendiente' — nunca 'completada'/'rechazada' desde
          // el cliente.
          request.resource.data.origen == 'autoasignada' &&
          request.resource.data.creadorId == request.auth.uid &&
          request.resource.data.estado == 'pendiente'
        )
      );

      allow update: if request.auth != null && (
        // Flujo 'asignada': sin cambios de comportamiento — admin puede
        // escribir cualquier cosa (asignarEstudiantes/completarTarea/etc).
        (isAdmin() && resource.data.get('origen', 'asignada') == 'asignada') ||
        // Admin resuelve una revisión: 'en_revision' -> 'completada', o
        // -> 'rechazada' con motivoRechazo obligatorio (sin excepción).
        // Es la ÚNICA transición que un admin puede hacer sobre una
        // autoasignada — el resto de su ciclo de vida lo maneja el
        // creador (rama de abajo); así 'en_revision' queda realmente
        // congelada para cualquiera que no sea admin resolviéndola.
        (
          isAdmin() &&
          resource.data.get('origen', 'asignada') == 'autoasignada' &&
          resource.data.estado == 'en_revision' &&
          (
            request.resource.data.estado == 'completada' ||
            (
              request.resource.data.estado == 'rechazada' &&
              request.resource.data.motivoRechazo is string &&
              request.resource.data.motivoRechazo.size() > 0 &&
              request.resource.data.motivoRechazo.size() <= 2000
            )
          )
        ) ||
        // El creador edita campos de la suya mientras sigue editable
        // ('pendiente' o 'rechazada'), SIN tocar estado — separado a
        // propósito de la rama de abajo (enviar a revisión): si ambas
        // fueran la misma rama, una sola escritura podría inflar
        // horasAOtorgar justo al mandar a revisión, sin que quede
        // señalado como cambio posterior a la creación (encontrado en
        // auditoría de esta fase, ver firebase-security-rules-auditor).
        // hasOnly() cierra ese hueco: esta rama no puede tocar estado/
        // fotoEvidenciaUrl/motivoRechazo/creadorId/origen, solo los 4
        // campos que edita editarTareaAutoasignada() en chores.js.
        (
          resource.data.get('origen', 'asignada') == 'autoasignada' &&
          resource.data.creadorId == request.auth.uid &&
          resource.data.estado in ['pendiente', 'rechazada'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['titulo', 'tipo', 'horasAOtorgar', 'asignados'])
        ) ||
        // El creador envía/reenvía a revisión: 'pendiente'|'rechazada' ->
        // 'en_revision', con evidencia obligatoria — hasOnly() restringe
        // esta escritura a EXACTAMENTE los 3 campos que toca
        // enviarARevision() en chores.js, así no puede colarse un cambio
        // de horasAOtorgar/asignados/titulo en la misma operación.
        (
          resource.data.get('origen', 'asignada') == 'autoasignada' &&
          resource.data.creadorId == request.auth.uid &&
          resource.data.estado in ['pendiente', 'rechazada'] &&
          request.resource.data.estado == 'en_revision' &&
          request.resource.data.fotoEvidenciaUrl is string &&
          request.resource.data.fotoEvidenciaUrl.size() > 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'fotoEvidenciaUrl', 'motivoRechazo'])
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.get('origen', 'asignada') == 'autoasignada' &&
          resource.data.creadorId == request.auth.uid &&
          resource.data.estado == 'pendiente'
        )
      );
    }

    // proyectos: organiza tareas existentes (tareas.proyectoId), no las
    // duplica — mismo criterio de permisos que tareas, crear/editar
    // proyectos y asignar pasos es coordinación, no autoservicio.
    match /proyectos/{proyectoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // asistencias es la fuente única de horas (Fase 13.2) — automáticas
    // (Regla del Sábado), ad-hoc y ajustes de migración conviven aquí,
    // todas con origen/motivo/autorizadoPor. Append-only: ni siquiera un
    // admin puede update/delete, igual que registro_actividad — una
    // corrección se hace con un nuevo registro negativo, nunca editando
    // uno existente, para que el historial sea confiable para un reporte
    // a la universidad.
    match /asistencias/{asistenciaId} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null && isAdmin();
      allow update, delete: if false;
    }

    match /inventario_general/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // historial_cultivo: append-only, mismo criterio que asistencias —
    // cualquiera puede cerrar un cultivo (create), nadie edita/borra un
    // cierre ya escrito. Confirmado por grep (ver PASO B): ningún código
    // existente hace update/delete sobre esta colección.
    match /historial_cultivo/{registroId} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null;
      allow update, delete: if false;
    }

    // bitacora_sesiones: append-only, sin restricción de una-por-fecha —
    // corregir una entrada mal escrita es crear una nueva, no editar la
    // vieja, mismo criterio que el resto del historial de auditoría.
    match /bitacora_sesiones/{sesionId} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null;
      allow update, delete: if false;
    }

    // ── Usuarios ──────────────────────────────────────────────────
    // Un admin nunca se autoasigna — se promueve manualmente (Fase 13).
    // create: solo el propio uid, y solo con rol en la whitelist —
    // 'admin' es explícitamente imposible en la escritura inicial, sin
    // importar qué mande el cliente. horasTotales debe nacer en 0 (no
    // solo por convención de registrarUsuario(), sino forzado aquí).
    // update: un admin puede escribir cualquier cosa en cualquier perfil
    // (incluida la promoción a admin, y ajustarHoras()). Un no-admin
    // editando su propio perfil (futura vista de Perfil/Ajustes) puede
    // cambiar su rol solo entre estudiante/externo, y nunca sus propias
    // horasTotales — eso sigue siendo exclusivo de ajustarHoras() por
    // un admin.
    match /usuarios/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.rol in ['estudiante', 'externo']
                    && request.resource.data.horasTotales == 0;

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.rol in ['estudiante', 'externo'] &&
          request.resource.data.horasTotales == resource.data.horasTotales
        )
      );

      allow delete: if request.auth != null && isAdmin();
    }
  }
}